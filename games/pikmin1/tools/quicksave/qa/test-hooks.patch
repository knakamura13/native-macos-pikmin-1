+// ---- QS TEST HOOK (scratch only, never committed) ----
+// PIKMIN_QS_SCRIPT=<file>, one event per line, "<tick> <kind> [args]"; <tick>
+// is the 1-based tick whose sim consumes the input:
+//   motion dx dy | wheel n | button mask-hex hold | fp
+//   bomb p | lockon p | charge p          window press queues of player p
+//   swarm hold                            Swarm button held (player 0)
+//   drag v                                camera drag of player 0
+//   vpad                                  attach a virtual game controller
+//   vpaddown hold                         its D-pad Down held
+//   paddown hold                          D-pad Down as the gamepad reader sets it
+//   photo                                 photo mode toggle request
+//   photomove x y hold                    photo mode touch move
+//   stick x y hold                        pad 0 main stick override
+//   setting Label_With_Underscores dir    F1 row change through the rows API
+//   settingsreset                         the "Reset all settings" row
+#include "settings/pc_settings_rows.h"
+#include "pc_photo_mode.h"
+struct QsEv { unsigned tick; int kind; float a; float b; int hold; std::string s; };
+static std::vector<QsEv> sQsEvents;
+static bool sQsLoaded = false;
+static unsigned sQsLastTick = 0xFFFFFFFFu;
+static SDL_Joystick* sQsVJoy = nullptr;
+static void qsLoad() {
+    if (sQsLoaded) return;
+    sQsLoaded = true;
+    const char* path = std::getenv("PIKMIN_QS_SCRIPT");
+    if (path == nullptr || *path == '\0') return;
+    FILE* f = std::fopen(path, "r");
+    if (f == nullptr) { printf("[QS-INJ] cannot open %s\n", path); return; }
+    char line[256];
+    while (std::fgets(line, sizeof(line), f)) {
+        unsigned tick = 0; char kind[32] = {}; char a[64] = {}; char b[64] = {}; char c[64] = {};
+        const int n = std::sscanf(line, "%u %31s %63s %63s %63s", &tick, kind, a, b, c);
+        if (n < 2) continue;
+        QsEv ev{ tick, -1, 0.0f, 0.0f, 0, std::string() };
+        if (std::strcmp(kind, "motion") == 0 && n >= 4) { ev.kind = 0; ev.a = std::strtof(a, nullptr); ev.b = std::strtof(b, nullptr); }
+        else if (std::strcmp(kind, "wheel") == 0) { ev.kind = 1; ev.a = std::strtof(a, nullptr); }
+        else if (std::strcmp(kind, "button") == 0 && n >= 4) { ev.kind = 2; ev.a = (float)std::strtoul(a, nullptr, 16); ev.hold = std::atoi(b); }
+        else if (std::strcmp(kind, "fp") == 0) { ev.kind = 3; }
+        else if (std::strcmp(kind, "bomb") == 0) { ev.kind = 4; ev.a = (float)std::atoi(a); }
+        else if (std::strcmp(kind, "lockon") == 0) { ev.kind = 5; ev.a = (float)std::atoi(a); }
+        else if (std::strcmp(kind, "charge") == 0) { ev.kind = 6; ev.a = (float)std::atoi(a); }
+        else if (std::strcmp(kind, "swarm") == 0) { ev.kind = 7; ev.hold = std::atoi(a); }
+        else if (std::strcmp(kind, "drag") == 0) { ev.kind = 8; ev.a = std::strtof(a, nullptr); }
+        else if (std::strcmp(kind, "vpad") == 0) { ev.kind = 9; }
+        else if (std::strcmp(kind, "vpaddown") == 0) { ev.kind = 10; ev.hold = std::atoi(a); }
+        else if (std::strcmp(kind, "paddown") == 0) { ev.kind = 11; ev.hold = std::atoi(a); }
+        else if (std::strcmp(kind, "photo") == 0) { ev.kind = 12; }
+        else if (std::strcmp(kind, "photomove") == 0 && n >= 5) { ev.kind = 13; ev.a = std::strtof(a, nullptr); ev.b = std::strtof(b, nullptr); ev.hold = std::atoi(c); }
+        else if (std::strcmp(kind, "stick") == 0 && n >= 5) { ev.kind = 14; ev.a = std::strtof(a, nullptr); ev.b = std::strtof(b, nullptr); ev.hold = std::atoi(c); }
+        else if (std::strcmp(kind, "setting") == 0 && n >= 4) { ev.kind = 15; ev.s = a; for (char& ch : ev.s) if (ch == '_') ch = ' '; ev.a = (float)std::atoi(b); }
+        else if (std::strcmp(kind, "settingsreset") == 0) { ev.kind = 16; ev.s = "Reset all settings to defaults"; }
+        else if (std::strcmp(kind, "settingok") == 0 && n >= 3) { ev.kind = 17; ev.s = a; for (char& ch : ev.s) if (ch == '_') ch = ' '; }
+        if (ev.kind >= 0) sQsEvents.push_back(ev);
+    }
+    std::fclose(f);
+    printf("[QS-INJ] loaded %u events from %s\n", (unsigned)sQsEvents.size(), path);
+    fflush(stdout);
+}
+static const QsEv* qsHeld(int kind) {
+    qsLoad();
+    const unsigned next = pc_netplay_tick() + 1;
+    for (const QsEv& ev : sQsEvents) {
+        if (ev.kind == kind && next >= ev.tick && next < ev.tick + (unsigned)ev.hold) return &ev;
+    }
+    return nullptr;
+}
+static bool qsFindRow(const std::string& label, int* group, int* row) {
+    for (int g = 0; g < PC_SET_GROUP_COUNT; g++) {
+        const int n = pc_settings_rows_count(g);
+        for (int r = 0; r < n; r++) {
+            const char* l = pc_settings_row_label(g, r);
+            if (l != nullptr && label == l) { *group = g; *row = r; return true; }
+        }
+    }
+    return false;
+}
+static void qsSettingAttempt(const QsEv& ev, unsigned next) {
+    int g = -1, r = -1;
+    if (!qsFindRow(ev.s, &g, &r)) { printf("[QS-SET] tick=%u row '%s' not found\n", next, ev.s.c_str()); return; }
+    char before[96] = {}, after[96] = {};
+    pc_settings_row_value(g, r, before, sizeof(before));
+    const unsigned long long hashBefore = pc_settings_sim_config_hash();
+    const bool enabled = pc_settings_row_enabled(g, r);
+    pc_settings_rows_begin();
+    pc_settings_row_change(g, r, ev.kind >= 16 ? 0 : (int)ev.a, ev.kind >= 16);
+    pc_settings_rows_end(true);
+    pc_settings_row_value(g, r, after, sizeof(after));
+    printf("[QS-SET] tick=%u row '%s' (g%d r%d) enabled=%d locked=%d value '%s' -> '%s' simhash %016llx -> %016llx help='%s'\n",
+           next, ev.s.c_str(), g, r, enabled ? 1 : 0, pc_settings_sim_locked(), before, after, hashBefore,
+           pc_settings_sim_config_hash(), pc_settings_row_help(g, r));
+}
