+void qsHookTickEnd()
+{
+	static int from = -2, to = 0;
+	if (from == -2) {
+		from = -1;
+		if (const char* s = getenv("PIKMIN_QS_CAMLOG")) sscanf(s, "%d:%d", &from, &to);
+	}
+	const int t = (int)pc_netplay_tick();
+	// Dumps and the captain's log, by the tick's offset in the day.
+	static unsigned seen = 0xFFFFFFFFu;
+	if (gQsHookInDay && pc_netplay_tick() != seen) {
+		seen          = pc_netplay_tick();
+		const int off = (int)(pc_netplay_tick() - gQsHookDayStart);
+		if (off == 1) qsHookDump("first");
+		if (const char* s = getenv("PIKMIN_QS_DUMP_OFFS")) {
+			const char* p = s;
+			while (*p) {
+				char* end    = nullptr;
+				const long v = strtol(p, &end, 10);
+				if (end == p) break;
+				if (v == off) {
+					char tag[32];
+					snprintf(tag, sizeof(tag), "off%ld", v);
+					qsHookDump(tag);
+				}
+				p = (*end == ',') ? end + 1 : end;
+			}
+		}
+		static const int every = getenv("PIKMIN_QS_NAVILOG") ? atoi(getenv("PIKMIN_QS_NAVILOG")) : 0;
+		if (every > 0 && off % every == 0 && naviMgr) {
+			Navi* n    = naviMgr->getNavi();
+			int sprouts = 0, pikis = 0;
+			if (itemMgr) {
+				Iterator it(itemMgr->getPikiHeadMgr());
+				CI_LOOP(it) sprouts++;
+			}
+			if (pikiMgr) {
+				Iterator it(pikiMgr);
+				CI_LOOP(it) pikis++;
+			}
+			printf("[QS-NAVI] t=%u off=%d pos=(%.2f %.2f) face=%.3f state=%d pikis=%d sprouts=%d\n", pc_netplay_tick(), off,
+			       n->mSRT.t.x, n->mSRT.t.z, n->mFaceDirection, n->getCurrState() ? n->getCurrState()->getID() : -1, pikis,
+			       sprouts);
+			fflush(stdout);
+		}
+	}
+	if (from < 0 || t < from || t > to || !naviMgr || !cameraMgr) return;
+	PcamCamera* c = cameraMgr->mCamera;
+	printf("[QS-CAM] t=%d event=%d vp=(%a %a %a) wp=(%a %a %a) rot=%a cam=(%a %a %a)\n", t, cameraMgr->mCurrEventIndex,
+	       c->mViewpoint.x, c->mViewpoint.y, c->mViewpoint.z, c->mWatchpoint.x, c->mWatchpoint.y, c->mWatchpoint.z,
+	       c->mRotationAngle, c->mCamera->mPosition.x, c->mCamera->mPosition.y, c->mCamera->mPosition.z);
+	fflush(stdout);
+}
+static void qsHookPlantSprouts(int count)
+{
+	Navi* n = naviMgr ? naviMgr->getNavi() : nullptr;
+	if (!n) return;
+	int planted = 0;
+	for (int i = 0; i < count; i++) {
+		PikiHeadItem* item = static_cast<PikiHeadItem*>(itemMgr->birth(OBJTYPE_Pikihead));
+		if (!item) break;
+		const f32 ang = 0.7f * i + 0.31f, r = 24.0f + 3.37f * i;
+		item->mSRT.t.set(n->mSRT.t.x + r * sinf(ang) + 0.413f, 0.0f, n->mSRT.t.z + r * cosf(ang) + 0.271f);
+		item->mSRT.r.set(0.0f, 0.37f * i + 0.5f, 0.0f);
+		item->mSRT.t.y = mapMgr->getMinY(item->mSRT.t.x, item->mSRT.t.z, true);
+		item->init(item->mSRT.t);
+		item->setColor(Red);
+		item->mFlowerStage = i % 3;
+		item->startAI(0);
+		C_SAI(item)->start(item, PikiHeadAI::PIKIHEAD_Wait);
+		planted++;
+	}
+	printf("[QS-SPROUTS] tick=%u planted %d around (%.2f %.2f)\n", pc_netplay_tick(), planted, n->mSRT.t.x, n->mSRT.t.z);
+	fflush(stdout);
+}
+// Captain 0 goes for the nearest sprout he can pull and plucks it, as the
+// pluck button does in range (Navi's own NukuAdjust path, any distance).
+static void qsHookPluck()
+{
+	Navi* n = naviMgr ? naviMgr->getNavi() : nullptr;
+	if (!n || !itemMgr) return;
+	PikiHeadItem* best = nullptr;
+	f32 bestDist       = 1e30f;
+	Iterator it(itemMgr->getPikiHeadMgr());
+	CI_LOOP(it)
+	{
+		Creature* c = *it;
+		if (c->mObjType != OBJTYPE_Pikihead) continue;
+		PikiHeadItem* s = static_cast<PikiHeadItem*>(c);
+		if (!s->canPullout()) continue;
+		const f32 dx = s->mSRT.t.x - n->mSRT.t.x, dz = s->mSRT.t.z - n->mSRT.t.z;
+		const f32 d  = dx * dx + dz * dz;
+		if (d < bestDist) {
+			bestDist = d;
+			best     = s;
+		}
+	}
+	const int state = n->getCurrState() ? n->getCurrState()->getID() : -1;
+	if (!best || state != NAVISTATE_Walk) {
+		printf("[QS-PLUCK] tick=%u nothing (sprout %p, navi state %d)\n", pc_netplay_tick(), (void*)best, state);
+		fflush(stdout);
+		return;
+	}
+	n->mPressedTimer = 0.0f;
+	n->startMotion(PaniMotionInfo(PIKIANIM_Asibumi), PaniMotionInfo(PIKIANIM_Asibumi));
+	Vector3f sep     = best->mSRT.t - n->mSRT.t;
+	n->_7D0          = angDist(roundAng(atan2f(sep.x, sep.z)), n->mFaceDirection) / 10.0f;
+	const f32 dist   = sep.length();
+	n->_7C4          = 3.0003002f * ((1.0f / dist) * (dist - 15.0f)) * sep;
+	n->_7B8          = 2;
+	n->mSproutToPluck = best;
+	n->mPikiToPluck   = 0;
+	n->mStateMachine->transit(n, NAVISTATE_NukuAdjust);
+	printf("[QS-PLUCK] tick=%u sprout at (%.3f %.3f) dist %.2f\n", pc_netplay_tick(), best->mSRT.t.x, best->mSRT.t.z, dist);
+	fflush(stdout);
+}
