+static void qsQuickSaveHooks() {
+    static bool init = false;
+    static std::vector<unsigned> saves;
+    static unsigned loadTick = 0;
+    static std::string loadPath;
+    static unsigned last = 0xFFFFFFFFu;
+    if (!init) {
+        init = true;
+        // PIKMIN_QS_DIRECT_SLOT=<1-3>: --coop-direct continues that card file.
+        if (const char* s = std::getenv("PIKMIN_QS_DIRECT_SLOT")) {
+            pc_coop_direct_set_slot(std::atoi(s));
+            printf("[QS-HOOK] co-op direct boot into file %d\n", std::atoi(s));
+        }
+        if (const char* s = std::getenv("PIKMIN_QS_SAVE_AT")) {
+            const char* p = s;
+            while (*p) {
+                char* end = nullptr;
+                const unsigned long v = std::strtoul(p, &end, 10);
+                if (end == p) break;
+                saves.push_back((unsigned)v);
+                p = (*end == ',') ? end + 1 : end;
+            }
+        }
+        if (const char* s = std::getenv("PIKMIN_QS_LOAD_AT")) {
+            char* end = nullptr;
+            loadTick = (unsigned)std::strtoul(s, &end, 10);
+            if (end && *end == ':') loadPath = end + 1;
+        }
+    }
+    const unsigned next = pc_netplay_tick() + 1;
+    if (next == last) return;
+    last = next;
+    for (unsigned& t : saves) {
+        if (t != 0 && t == next) {
+            printf("[QS-HOOK] tick=%u quick save action\n", next);
+            fflush(stdout);
+            t = 0;
+            pc_quicksave_request_save();
+        }
+    }
+    if (loadTick != 0 && loadTick == next) {
+        printf("[QS-HOOK] tick=%u quick load action %s\n", next, loadPath.c_str());
+        fflush(stdout);
+        loadTick = 0;
+        pc_quicksave_request_load_file(loadPath.c_str());
+    }
+}
+extern int gQsHookDay;
+extern unsigned gQsHookDayStart;
+extern bool gQsHookInDay;
+static std::vector<unsigned> sQsDaySaves;
+static unsigned sQsDayLoadTick = 0;
+static std::string sQsDayLoadPath;
+void qsHookDayBegin(int day, unsigned start) {
+    qsLoad();
+    gQsHookDay = day;
+    gQsHookDayStart = start;
+    gQsHookInDay = true;
+    printf("[QS-HOOK] day %d begins at tick %u\n", day, start);
+    // A day's script is placed once: a load re-enters the day at the same
+    // tick numbers, and the events already placed stay.
+    static std::vector<int> sQsScriptDays;
+    bool scripted = false;
+    for (int d : sQsScriptDays) scripted = scripted || d == day;
+    sQsScriptDays.push_back(day);
+    if (const char* path = scripted ? nullptr : std::getenv("PIKMIN_QS_DSCRIPT")) {
+        if (FILE* f = std::fopen(path, "r")) {
+            char line[256];
+            int added = 0;
+            while (std::fgets(line, sizeof(line), f)) {
+                int d = 0; unsigned o = 0; char rest[200] = {};
+                if (std::sscanf(line, "%d %u %199[^\n]", &d, &o, rest) != 3 || d != day) continue;
+                char conv[256];
+                std::snprintf(conv, sizeof(conv), "%u %s\n", start + o, rest);
+                unsigned tick = 0; char kind[32] = {}; char a[64] = {}; char b[64] = {}; char c[64] = {};
+                const int n = std::sscanf(conv, "%u %31s %63s %63s %63s", &tick, kind, a, b, c);
+                QsEv ev{ tick, -1, 0.0f, 0.0f, 0, std::string() };
+                if (std::strcmp(kind, "motion") == 0 && n >= 4) { ev.kind = 0; ev.a = std::strtof(a, nullptr); ev.b = std::strtof(b, nullptr); }
+                else if (std::strcmp(kind, "wheel") == 0) { ev.kind = 1; ev.a = std::strtof(a, nullptr); }
+                else if (std::strcmp(kind, "button") == 0 && n >= 4) { ev.kind = 2; ev.a = (float)std::strtoul(a, nullptr, 16); ev.hold = std::atoi(b); }
+                else if (std::strcmp(kind, "bomb") == 0) { ev.kind = 4; ev.a = (float)std::atoi(a); }
+                else if (std::strcmp(kind, "stick") == 0 && n >= 5) { ev.kind = 14; ev.a = std::strtof(a, nullptr); ev.b = std::strtof(b, nullptr); ev.hold = std::atoi(c); }
+                if (ev.kind >= 0) { sQsEvents.push_back(ev); added++; }
+            }
+            std::fclose(f);
+            printf("[QS-HOOK] day %d: %d day-script events from tick %u\n", day, added, start);
+        }
+    }
+    if (const char* s = scripted ? nullptr : std::getenv("PIKMIN_QS_SAVE_DAY")) {
+        const char* p = s;
+        while (*p) {
+            int d = 0; unsigned o = 0; int used = 0;
+            if (std::sscanf(p, "%d:%u%n", &d, &o, &used) != 2) break;
+            if (d == day) sQsDaySaves.push_back(start + o);
+            p += used;
+            if (*p == ',') p++;
+        }
+    }
+    if (const char* s = scripted ? nullptr : std::getenv("PIKMIN_QS_LOAD_DAY")) {
+        int d = 0; unsigned o = 0; int used = 0;
+        if (std::sscanf(s, "%d:%u:%n", &d, &o, &used) == 2 && d == day && used > 0) {
+            sQsDayLoadTick = start + o;
+            sQsDayLoadPath = s + used;
+        }
+    }
+    fflush(stdout);
+}
+static void qsDayHooks() {
+    const unsigned next = pc_netplay_tick() + 1;
+    static unsigned last = 0xFFFFFFFFu;
+    if (next == last) return;
+    last = next;
+    for (unsigned& t : sQsDaySaves) {
+        if (t != 0 && t == next) {
+            printf("[QS-HOOK] tick=%u quick save action (day %d, offset %u)\n", next, gQsHookDay, next - gQsHookDayStart);
+            fflush(stdout);
+            t = 0;
+            pc_quicksave_request_save();
+        }
+    }
+    if (sQsDayLoadTick != 0 && sQsDayLoadTick == next) {
+        printf("[QS-HOOK] tick=%u quick load action %s\n", next, sQsDayLoadPath.c_str());
+        fflush(stdout);
+        sQsDayLoadTick = 0;
+        pc_quicksave_request_load_file(sQsDayLoadPath.c_str());
+    }
+}
+static void qsInjectStream() {
+    qsLoad();
+    qsQuickSaveHooks();
+    qsDayHooks();
+    if (sQsEvents.empty()) return;
+    const unsigned next = pc_netplay_tick() + 1;
+    if (next == sQsLastTick) return;
+    sQsLastTick = next;
+    if (sQsVJoy != nullptr) {
+        const bool down = qsHeld(10) != nullptr;
+        const int setRc = SDL_JoystickSetVirtualButton(sQsVJoy, SDL_CONTROLLER_BUTTON_DPAD_DOWN, down ? 1 : 0);
+        static bool sQsPrevDown = false;
+        if (down || sQsPrevDown) {
+            SDL_JoystickUpdate();
+            printf("[QS-VPAD] tick=%u want=%d setRc=%d joyBtn=%d ctl=%p explicit=%d gcBtn=%d held=%d\n", next, down ? 1 : 0, setRc,
+                   (int)SDL_JoystickGetButton(sQsVJoy, SDL_CONTROLLER_BUTTON_DPAD_DOWN), (void*)sControllers[0],
+                   sPlayerDeviceExplicit ? 1 : 0,
+                   sControllers[0] ? (int)SDL_GameControllerGetButton(sControllers[0], SDL_CONTROLLER_BUTTON_DPAD_DOWN) : -1,
+                   sPadDpadDownHeld[0] ? 1 : 0);
+        }
+        sQsPrevDown = down;
+    }
+    const QsEv* pm = qsHeld(13);
+    pc_photo_mode_set_touch_move(pm ? pm->a : 0.0f, pm ? pm->b : 0.0f);
+    for (const QsEv& ev : sQsEvents) {
+        if (ev.tick != next) continue;
+        if (ev.kind == 0) {
+            pc_window_add_cursor_delta(ev.a, ev.b);
+            printf("[QS-INJ] tick=%u motion %a %a\n", next, ev.a, ev.b);
+        } else if (ev.kind == 1) {
+            SDL_Event e;
+            std::memset(&e, 0, sizeof(e));
+            e.type            = SDL_MOUSEWHEEL;
+            e.wheel.y         = (int)ev.a;
+            e.wheel.preciseY  = ev.a;
+            e.wheel.direction = SDL_MOUSEWHEEL_NORMAL;
+            e.wheel.windowID  = SDL_GetWindowID(sWindow);
+            const int pushed  = SDL_PushEvent(&e);
+            sMouseWheelSteps  = std::clamp(sMouseWheelSteps + (int)ev.a, -kMaxPendingWheelSteps, kMaxPendingWheelSteps);
+            printf("[QS-INJ] tick=%u wheel %d pushed=%d pending=%d\n", next, (int)ev.a, pushed, sMouseWheelSteps);
+        } else if (ev.kind == 3) {
+            pc_window_request_firstperson_press();
+            printf("[QS-INJ] tick=%u first-person toggle\n", next);
+        } else if (ev.kind == 4) {
+            pc_window_request_bomb_press((int)ev.a);
+            printf("[QS-INJ] tick=%u bomb p%d\n", next, (int)ev.a);
+        } else if (ev.kind == 5) {
+            pc_window_request_lockon_press((int)ev.a);
+            printf("[QS-INJ] tick=%u lockon p%d\n", next, (int)ev.a);
+        } else if (ev.kind == 6) {
+            pc_window_request_charge_press((int)ev.a);
+            printf("[QS-INJ] tick=%u charge p%d\n", next, (int)ev.a);
+        } else if (ev.kind == 8) {
+            pc_window_add_camera_drag_player(0, ev.a);
+            printf("[QS-INJ] tick=%u drag %a\n", next, ev.a);
+        } else if (ev.kind == 9) {
+            const int idx = SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_GAMECONTROLLER, SDL_CONTROLLER_AXIS_MAX,
+                                                      SDL_CONTROLLER_BUTTON_MAX, 0);
+            sQsVJoy = idx >= 0 ? SDL_JoystickOpen(idx) : nullptr;
+            printf("[QS-INJ] tick=%u vpad attach idx=%d joy=%p gc=%d err='%s'\n", next, idx, (void*)sQsVJoy,
+                   idx >= 0 ? (int)SDL_IsGameController(idx) : -1, SDL_GetError());
+        } else if (ev.kind == 12) {
+            pc_photo_mode_request_toggle();
+            printf("[QS-INJ] tick=%u photo toggle request\n", next);
+        } else if (ev.kind == 15 || ev.kind == 16 || ev.kind == 17) {
+            static std::vector<const QsEv*> consumed;
+            if (std::find(consumed.begin(), consumed.end(), &ev) != consumed.end()) continue;
+            consumed.push_back(&ev);
+            qsSettingAttempt(ev, next);
+        }
+    }
+    fflush(stdout);
+}
+static u16 qsButtons() {
+    qsLoad();
+    const unsigned next = pc_netplay_tick() + 1;
+    u16 mask = 0;
+    for (const QsEv& ev : sQsEvents) {
+        if (ev.kind == 2 && next >= ev.tick && next < ev.tick + (unsigned)ev.hold) mask |= (u16)ev.a;
+    }
+    static const bool menuA = std::getenv("PIKMIN_QS_MENU_A") != nullptr;
+    if (menuA && !gQsHookInDay && next >= 60 && next % 40 < 2) mask |= PAD_BUTTON_A;
+    return mask;
+}
