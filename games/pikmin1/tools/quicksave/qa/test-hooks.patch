+				fprintf(f, "piki %d color=%d happa=%d pos=(%a %a %a) face=%a\n", np++, p->mColor, p->mHappa, p->mSRT.t.x,
+				        p->mSRT.t.y, p->mSRT.t.z, p->mFaceDirection);
